{
  "name": "thomas-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "pages:build": "node scripts/build-cloudflare.mjs",
    "pages:dev": "wrangler pages dev .vercel/output/static",
    "pages:deploy": "npm run pages:build && wrangler pages deploy .vercel/output/static --project-name thomas-nicoli",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run tests/functions tests/worker tests/config",
    "clarity:worker": "tsx tools/project-clarity-worker/cli.ts",
    "clarity:retention": "tsx tools/project-clarity-worker/cli.ts retention-preview",
    "clarity:queue-purge": "tsx tools/project-clarity-worker/cli.ts queue-purge --confirm-expired",
    "clarity:qa-motion": "node scripts/project-clarity-motion-qa.mjs",
    "chat:worker": "tsx tools/site-chat-worker/cli.ts once",
    "chat:daemon": "tsx tools/site-chat-worker/cli.ts daemon",
    "chat:qa-browser": "node scripts/site-chat-browser-qa.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "clsx": "^2.1.1",
    "lenis": "^1.3.25",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.61.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0"
  },
  "overrides": {
    "postcss": "^8.5.22",
    "sharp": "^0.35.3"
  }
}
