# Public site URL (no trailing slash) — used for canonical URLs, sitemap and OG
NEXT_PUBLIC_SITE_URL=https://thomas-nicoli.com

# Contact delivery on Cloudflare Pages (same names as the existing project)
RESEND_API_KEY=
RESEND_TO=
# Existing verified Resend domain, e.g. emails.thomas-nicoli.com or resend.dev
MAIL_DOMAIN=
# Optional full sender override, e.g. Thomas Nicoli Consulting <hello@example.com>
RESEND_FROM_EMAIL=

# Optional contact channels — when set, the UI shows the related buttons
NEXT_PUBLIC_CALENDAR_URL=
NEXT_PUBLIC_WHATSAPP_URL=

# Feature flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_EXPERIMENTAL_WEBGPU=false

# Cloudflare Turnstile
# Public build variable; use the Cloudflare test site key only in local/QA environments.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Pages secret; never prefix with NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=

# Project Clarity local defaults stay fail-closed. Preview/production activation lives in wrangler.toml.
NEXT_PUBLIC_PROJECT_CLARITY_LEGAL_READY=false
PROJECT_CLARITY_SUBMISSIONS_ENABLED=false
PROJECT_CLARITY_LEGAL_APPROVED=false
PROJECT_CLARITY_CONSENT_VERSION=
# Required only after approved wording supplies an exact duration.
PROJECT_CLARITY_RETENTION_DAYS=
# Cloudflare Pages secret shared only with the local worker.
PROJECT_CLARITY_WORKER_TOKEN=
# D1 binding configured in Cloudflare/Wrangler, not a secret value:
# PROJECT_CLARITY_DB

# Private local worker environment (never exposed to Next.js or the browser)
PROJECT_CLARITY_QUEUE_URL=
PROJECT_CLARITY_LEAD_VAULT=<absolute-path-to-separate-lead-vault>
PROJECT_CLARITY_PERSONAL_VAULT=<absolute-path-to-personal-vault-used-for-isolation-check-only>
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4-local
