# Public site URL (no trailing slash) — used for canonical URLs, sitemap and OG
NEXT_PUBLIC_SITE_URL=https://thomas-nicoli.com

# Contact delivery on Cloudflare Pages (same names as the existing project)
RESEND_API_KEY=
RESEND_TO=
# Existing verified Resend domain, e.g. emails.thomas-nicoli.com or resend.dev
MAIL_DOMAIN=
# Optional full sender override, e.g. Thomas Nicoli Consulting <hello@example.com>
RESEND_FROM_EMAIL=

# Optional contact channels — when set, the UI shows the related buttons
NEXT_PUBLIC_CALENDAR_URL=
NEXT_PUBLIC_WHATSAPP_URL=

# Feature flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_EXPERIMENTAL_WEBGPU=false
