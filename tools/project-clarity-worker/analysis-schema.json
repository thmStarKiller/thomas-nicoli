{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "language",
    "summary",
    "observations",
    "nextStep",
    "notYet",
    "quickWins",
    "discoveryQuestions",
    "recommendedService",
    "missingInformation",
    "confidence",
    "riskFlags"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "language": { "enum": ["es", "en", "fr"] },
    "summary": { "type": "string", "minLength": 20, "maxLength": 600 },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 5, "maxLength": 240 }
    },
    "nextStep": { "type": "string", "minLength": 10, "maxLength": 400 },
    "notYet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 5, "maxLength": 240 }
    },
    "quickWins": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 5, "maxLength": 240 }
    },
    "discoveryQuestions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 5, "maxLength": 240 }
    },
    "recommendedService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "rationale"],
      "properties": {
        "id": {
          "enum": [
            "website",
            "local-visibility",
            "brand-content",
            "practical-ai",
            "commerce-crm",
            "delivery-support",
            "discovery"
          ]
        },
        "label": { "type": "string", "minLength": 2, "maxLength": 100 },
        "rationale": { "type": "string", "minLength": 10, "maxLength": 300 }
      }
    },
    "missingInformation": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "minLength": 3, "maxLength": 200 }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "riskFlags": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "enum": [
          "insufficient-information",
          "sensitive-data",
          "legal-or-compliance",
          "security",
          "unrealistic-timing",
          "unclear-owner",
          "none"
        ]
      }
    }
  }
}
